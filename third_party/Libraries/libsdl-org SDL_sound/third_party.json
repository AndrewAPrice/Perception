{
    "repositories": [
        {
            "url": "-b stable-2.0 https://github.com/icculus/SDL_sound.git",
            "type": "git",
            "placeholder": "git"
        }
    ],
    "operations": [
        {
            "operation": "copy",
            "source": "${git}/src/SDL_sound.h",
            "destination": "public/SDL_sound.h"
        },
        {
            "operation": "copy",
            "source": "${git}/src",
            "destination": "source",
            "recursive": true,
            "extensions": [
                ".c",
                ".h"
            ],
            "exclude": [
                "source/SDL_sound_skeleton.c",
                "source/SDL_sound_coreaudio.c",
                "source/SDL_sound.h"
            ]
        }
    ]
}
